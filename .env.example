# Copy this file to `.env.local` and fill in your Firebase web app config.
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only if you deploy Cloud Functions to a non-default region.
# VITE_FUNCTIONS_REGION=us-central1

# Optional: Cloudinary cloud name for auto-format (WebP/AVIF) + resize CDN.
# See src/utils/imgUrl.ts for setup instructions.
# VITE_CLOUDINARY_CLOUD_NAME=

